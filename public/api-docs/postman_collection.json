{
  "info": {
    "name": "ChoTot x eBay Marketplace",
    "_postman_id": "d4d7b5de-5f38-4b55-8f9c-2a23b3ea0001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Quick Postman collection for the marketplace backend."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "auctionId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "messageId", "value": "" },
    { "key": "escrowId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?limit=10"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"PASTE_CATEGORY_ID\",\n  \"title\": \"Postman demo product\",\n  \"description\": \"Created from Postman collection\",\n  \"price\": 2500000,\n  \"saleType\": \"fixed_price\",\n  \"condition\": \"good\",\n  \"status\": \"active\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auctions",
      "item": [
        {
          "name": "List Auctions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auctions?limit=10"
          }
        },
        {
          "name": "Place Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}/bids",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 15000000\n}"
            }
          }
        },
        {
          "name": "Close Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}/close",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"force\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations?limit=10"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Xin chao realtime chat\"\n}"
            }
          }
        },
        {
          "name": "Edit Message",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/messages/{{messageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Da sua tin nhan\"\n}"
            }
          }
        },
        {
          "name": "Mark Read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/conversations/{{conversationId}}/read"
          }
        }
      ]
    },
    {
      "name": "Escrows",
      "item": [
        {
          "name": "List Escrows",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/escrows?limit=10"
          }
        },
        {
          "name": "Dispute Escrow",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/escrows/{{escrowId}}/dispute",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Item not delivered\",\n  \"notes\": \"Opened from Postman\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Imports",
      "item": [
        {
          "name": "Chotot Import",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/imports/chotot",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryUrl\": \"https://xe.chotot.com/\",\n  \"categoryName\": \"Vehicles\",\n  \"maxPages\": 1,\n  \"mode\": \"html\"\n}"
            }
          }
        }
      ]
    }
  ]
}
